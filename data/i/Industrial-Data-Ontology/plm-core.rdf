    <ns0:imports rdf:resource="http://rds.posccaesar.org/ontology/plm/ont/core" />
    <ns0:versionIRI rdf:resource="http://rds.posccaesar.org/ontology/plm/ont/uom/0.9.1" />
    <ns0:versionInfo rdf:datatype="&xsd;string">0.9.1</ns0:versionInfo>
    <ns118:changeNote rdf:datatype="&xsd;string" xmlns:ns118="http://www.w3.org/2004/02/skos/core#">2026-08-25: Added direct skos:definition annotations to PLM RDL resources without iof-av:naturalLanguageDefinition, using applicable rdfs:comment values.</ns118:changeNote>
    <ns119:changeNote rdf:datatype="&xsd;string" xmlns:ns119="http://www.w3.org/2004/02/skos/core#">Moved definitions from core to chebi/uom.</ns119:changeNote>
    <ns120:homepage rdf:resource="http://rds.posccaesar.org/ontology/plm/doc/uom" xmlns:ns120="http://xmlns.com/foaf/0.1/" />
  </ns0:Ontology>
