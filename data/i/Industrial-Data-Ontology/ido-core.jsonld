      },
      {
        "@id": "http://rds.posccaesar.org/ontology/lis14/ont/core"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "lis-ext-qd-dt-owl"
      }
    ],
