    "http://purl.org/dc/terms/description": [
      {
        "@value": "The Industrial Data Ontology (IDO) is a Web Ontology Language (OWL) ontology. IDO is intended for building vocabularies and managing models which employ reference data libraries and exploit OWL DL. IDO is intended for use in all life cycle phases of industrial assets and processes."
      }
