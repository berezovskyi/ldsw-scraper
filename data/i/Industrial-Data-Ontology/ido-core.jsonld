    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Quality Property Aspect Extension Ontology OWL"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@value": "2026-05-09"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://orcid.org/0009-0003-7263-9946"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Defines property aspects of lis:Quality as OWL ontology\nBackground:\nThe Industrial Data Ontology (IDO) already establishes a clear distinction between properties (lis:Quality) and values (lis:QualityDatum).\nBuilding on this foundation, this ontology introduces aspects to further refine the semantics of properties (lis:Quality).\nAspects enable a more granular and standardized representation of property-related information,\nallowing for precise classification and contextualization of properties (lis:Quality) that describe the property itself,\nindependent of its specific values.\n\nThis ontology is inspired by and extends the plm ontology from POSC Caesar Association (PCA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://rds.posccaesar.org/ontology/plm/ont/core"
      }
    ],
