        "@value": "QualityDatum Data Type Extension Ontology OWL"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@value": "2021-02-15"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://orcid.org/0009-0005-9639-4327"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Defines basic data types of lis:QualityDatum in accordance with IEC61360-1 as OWL ontology\nBackground:\nThe Industrial Data Ontology (IDO) already establishes a clear distinction between properties (lis:Quality) and values (lis:QualityDatum).\nThis ontology extends the data type modeling for lis:QualityDatum by defining specific data types in accordance with IEC 61360-1.\nThe class names and labels are oriented towards the corresponding XSD data types to ensure consistency with standard data representations and interoperability.\nThis ontology aligns with the data type definitions in IEC 61360-1. "
      }
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@id": "https://orcid.org/0009-0003-7263-9946"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@value": "2026-06-01"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "QualityDatum Data Type Extension Ontology OWL"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
